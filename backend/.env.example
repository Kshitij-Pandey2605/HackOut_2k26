# ==============================================
# CarbonSphere Backend Environment Configuration
# ==============================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Supabase Configuration (Database + Auth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_EXPIRES_IN=7d

# Media & Document Storage (Cloudinary - Future Scope)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Geolocation & Distance Routing (Google Maps API - Future Scope)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# AI / ML Service (Optional Future Integration)
AI_SERVICE_ENDPOINT=http://localhost:8000
AI_SERVICE_API_KEY=your_ai_service_api_key
